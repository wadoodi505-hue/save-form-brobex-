import { useState, type FormEvent } from 'react';
import { motion } from 'framer-motion';
import { ArrowRight, ArrowUpRight, Check, ChevronDown, Clipboard, Download, FileVideo, Link2, LockKeyhole, ShieldCheck, Sparkles, Trash2, Youtube, Instagram, Music2 } from 'lucide-react';
import { Link } from 'react-router-dom'; import { Seo } from '../components/Seo';
const faqs=[['Can I download any video from any website?','No. Support depends on the source, its terms, technical access, and whether a permitted integration is available. This project does not bypass DRM, login walls, or access restrictions.'],['Does submitting a URL guarantee a download?','No. A URL may point to unsupported, private, unavailable, or non-downloadable content. The service will explain when it cannot process a link.'],['Is my submitted link private?','Links are sent to the application backend for validation. Like most web services, a deployed server may process technical request logs. Avoid submitting private or tokenized URLs.'],['Does the website store downloaded videos?','This starter implementation does not download or store media files. A compliant provider integration is required before actual media downloads can be offered.']];
export default function Home(){const [url,setUrl]=useState('');const [busy,setBusy]=useState(false);const [error,setError]=useState('');const [notice,setNotice]=useState('');
async function submit(e:FormEvent){e.preventDefault();setError('');setNotice('');const value=url.trim();if(!value){setError('Enter a URL to get started.');return}let parsed:URL;try{parsed=new URL(value)}catch{setError('That link does not look valid. Include the full https:// address.');return}if(!['http:','https:'].includes(parsed.protocol)){setError('Only HTTP and HTTPS links are accepted.');return}setBusy(true);try{const res=await fetch('/api/media/resolve',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({url:value})});const data=await res.json();if(!res.ok)throw new Error(data.error||'This link could not be processed.');if(data.status==='provider_not_configured')setNotice('The link passed validation, but a compliant media provider has not been configured yet. No download link was created.');else setNotice('The source was checked, but no downloadable result is available.');}catch(err){setError(err instanceof Error?err.message:'Something went wrong. Please try again.')}finally{setBusy(false)}}
async function paste(){try{const t=await navigator.clipboard.readText();setUrl(t);setError('');setNotice('')}catch{setError('Clipboard access was blocked. Paste your link into the field instead.')}}
return <><Seo title="Save From Brobex — Your Media. Your Choice." description="A simple, convenient way to access downloadable media from supported sources."/><section className="hero"><div className="hero-orb orb-one"/><div className="hero-orb orb-two"/><div className="hero-content"><motion.div initial={{opacity:0,y:12}} animate={{opacity:1,y:0}} transition={{duration:.5}} className="eyebrow"><span className="pulse-dot"/> SIMPLE BY DESIGN <span className="eyebrow-line"/> RESPONSIBLE BY DEFAULT</motion.div><motion.h1 initial={{opacity:0,y:18}} animate={{opacity:1,y:0}} transition={{duration:.65,delay:.08}}>Save From <span>Brobex</span></motion.h1><motion.p className="hero-sub" initial={{opacity:0,y:14}} animate={{opacity:1,y:0}} transition={{duration:.6,delay:.15}}>Your Media. Your Choice. <em>Made Simple.</em></motion.p><p className="hero-copy">A simple, convenient way to access downloadable media from supported sources. Paste a link to get started.</p><motion.form className="url-form glass" onSubmit={submit} initial={{opacity:0,y:18}} animate={{opacity:1,y:0}} transition={{duration:.6,delay:.22}}><div className="url-field-icon"><Link2 size={20}/></div><label className="sr-only" htmlFor="media-url">Enter your URL to download video</label><input id="media-url" type="url" inputMode="url" autoComplete="url" placeholder="Enter your URL to download video" value={url} onChange={e=>{setUrl(e.target.value);setError('');setNotice('')}} aria-describedby="url-feedback"/><button type="button" className="icon-action paste-btn" onClick={paste} aria-label="Paste URL from clipboard"><Clipboard size={17}/><span>Paste</span></button>{url&&<button type="button" className="icon-action clear-btn" onClick={()=>{setUrl('');setError('');setNotice('')}} aria-label="Clear URL"><Trash2 size={17}/></button>}<button className="submit-btn" type="submit" disabled={busy}>{busy?<span className="spinner"/>:<Download size={18}/>}<span>{busy?'Checking':'Get media'}</span><ArrowRight size={16}/></button></motion.form><div id="url-feedback" className={`form-feedback ${error?'is-error':''} ${notice?'is-notice':''}`} role="status" aria-live="polite">{error||notice}</div><div className="trust-row"><span><ShieldCheck size={15}/> Link validation</span><span><LockKeyhole size={15}/> Safety-minded design</span><span><Check size={15}/> No fabricated results</span></div><p className="hero-disclaimer">Only access media you have permission to use. Availability depends on source support and platform rules.</p></div><div className="hero-bottom"><span>BUILT FOR CLARITY</span><span className="hero-bottom-line"/><span>01 — 04</span></div></section>
<section className="supported section-wrap"><div className="section-kicker">SOURCE COMPATIBILITY</div><div className="supported-row"><div><span className="source-icon"><Youtube/></span><span><b>YouTube</b><small>Provider required</small></span></div><div><span className="source-icon"><Instagram/></span><span><b>Instagram</b><small>Provider required</small></span></div><div><span className="source-icon"><Music2/></span><span><b>TikTok</b><small>Provider required</small></span></div><p>Sources shown for awareness only. Downloads are not enabled until a compliant provider is configured.</p></div></section>
<section id="how-it-works" className="section-wrap how-section"><div className="section-heading"><div><div className="section-kicker">A BETTER WAY TO BEGIN</div><h2>Three steps. <span>No guesswork.</span></h2></div><p>Clear feedback at every step, so you know what the service can—and cannot—do.</p></div><div className="steps-grid"><article className="step-card"><span className="step-number">01 / INPUT</span><div className="step-icon"><Link2/></div><h3>Paste your link</h3><p>Start with a public URL from a source you are authorized to access.</p><span className="step-arrow"><ArrowRight/></span></article><article className="step-card"><span className="step-number">02 / CHECK</span><div className="step-icon"><ShieldCheck/></div><h3>Validate the source</h3><p>The server checks the URL and reports whether an integration can handle it.</p><span className="step-arrow"><ArrowRight/></span></article><article className="step-card"><span className="step-number">03 / RESULT</span><div className="step-icon"><FileVideo/></div><h3>Review what’s available</h3><p>When a permitted provider is connected, genuine results can be shown here.</p><span className="step-arrow"><ArrowRight/></span></article></div></section>
<section className="feature-band"><div className="feature-inner"><div><div className="section-kicker">THE BROBEX STANDARD</div><h2>Useful by nature.<br/><span>Responsible by design.</span></h2><p>Tools should be easy to understand, honest about their limits, and built to respect the people who create the content we enjoy.</p><Link className="text-link" to="/about">Discover our approach <ArrowUpRight size={17}/></Link></div><div className="feature-list"><div><span><Sparkles/></span><div><h3>Clarity over clutter</h3><p>A focused interface with helpful states instead of confusing buttons.</p></div></div><div><span><ShieldCheck/></span><div><h3>Safety at every step</h3><p>Server-side validation and safeguards against unsafe URL requests.</p></div></div><div><span><LockKeyhole/></span><div><h3>Privacy-aware choices</h3><p>Minimal collection by design, with transparent service limitations.</p></div></div></div></div></section>
<section className="faq-section section-wrap"><div className="section-heading"><div><div className="section-kicker">GOOD TO KNOW</div><h2>Questions, <span>answered.</span></h2></div><Link className="text-link" to="/contact">Still curious? Contact us <ArrowUpRight size={16}/></Link></div><div className="faq-list">{faqs.map(([q,a])=><details key={q} className="faq-item"><summary>{q}<ChevronDown size={18}/></summary><p>{a}</p></details>)}</div></section>
<section className="contact-cta"><div className="cta-glow"/><div className="section-kicker">HAVE A PROJECT IN MIND?</div><h2>Good websites start<br/>with a <span>conversation.</span></h2><p>Need a polished digital experience for your business? Let's talk about what you want to build.</p><Link to="/contact" className="gold-btn">Talk to Brobex <ArrowUpRight size={17}/></Link><a href="https://brobexportfolio.vercel.app/" target="_blank" rel="noreferrer" className="cta-secondary">Explore developer portfolio ↗</a></section></>}
